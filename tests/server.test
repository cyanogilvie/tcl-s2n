source [file join [file dirname [info script]] common.tcl]

# Server role, with the certificates config: tests/certs has a test CA and two leaf certificates
# it signed (a.test and b.test, each with a wildcard), so a client that trusts only that CA and
# checks the name it asked for proves which certificate the server chose.  Both ends are
# non-blocking in this interp, on the event loop

namespace eval server_test {
	variable certs	[file join [file dirname [file normalize [info script]]] certs]

	proc pem name { #<<<
		variable certs
		set h	[open [file join $certs $name]]
		try {read $h} finally {close $h}
	}

	#>>>
	proc pair name {list [pem $name.pem] [pem $name.key]}

	proc push_server config { # Push the server role with $config onto a connected socket: push's result (closed again) <<<
		set listen	[socket -server {apply {{sock args} {close $sock}}} -myaddr 127.0.0.1 0]
		set sock	[socket 127.0.0.1 [lindex [chan configure $listen -sockname] 2]]
		chan configure $sock -blocking 0
		try {
			s2n::push $sock -role server -config $config
		} finally {
			catch {close $sock}
			close $listen
		}
	}

	#>>>

	proc accept {config sock args} { #<<<
		variable server_err
		chan configure $sock -blocking 0 -buffering none -translation binary
		try {
			s2n::push $sock -role server -blinding self {*}[if {$config ne ""} {list -config $config}]
		} on error {errmsg options} {
			set server_err $errmsg
			close $sock
			return
		}
		chan event $sock readable [list [namespace current]::serve $sock]
	}

	#>>>
	proc serve sock { #<<<
		variable server_err
		variable server_delay
		try {
			set line	[gets $sock]
		} on error errmsg {
			set server_err		$errmsg
			set server_delay	[chan configure $sock -blinding_delay]
			close $sock
			return
		}
		if {[eof $sock]} {close $sock; return}
		if {[chan blocked $sock]} return
		puts -nonewline $sock "echo: $line\n"
		close $sock
	}

	#>>>
	proc roundtrip {config servername} { # Connect as a client asking for $servername, trusting only the test CA: what the server answered, or the error <<<
		variable certs
		variable result
		variable server_err
		variable rx
		variable protocol
		unset -nocomplain result server_err server_delay
		set rx			{}
		set protocol	{}

		set listen	[socket -server [list [namespace current]::accept $config] -myaddr 127.0.0.1 0]
		set port	[lindex [chan configure $listen -sockname] 2]
		try {
			set sock	[s2n::socket -async -blinding self -servername $servername -config [list ca_file [file join $certs ca.pem]] 127.0.0.1 $port]
			chan configure $sock -blocking 0 -buffering none -translation binary
			chan event $sock writable [list apply {{sock ns} {
				chan event $sock writable {}
				try {
					puts -nonewline $sock "hello\n"
				} on error errmsg {
					set ${ns}::result [list error $errmsg]
				}
			}} $sock [namespace current]]
			chan event $sock readable [list apply {{sock ns} {
				try {
					append ${ns}::rx [read $sock]
				} on error errmsg {
					set ${ns}::result [list error $errmsg]
					return
				}
				if {[eof $sock]} {
					set ${ns}::protocol	[chan configure $sock -protocol]
					set ${ns}::result	[list ok [set ${ns}::rx]]
				}
			}} $sock [namespace current]]
			set timeout	[after 5000 [list set [namespace current]::result timeout]]
			vwait [namespace current]::result
			after cancel $timeout
			set result
		} finally {
			if {[info exists sock] && $sock in [chan names]} {catch {close $sock}}
			close $listen
		}
	}

	#>>>
}

test server-1.1 {A server with one certificate: a client checking its name gets through} -body { #<<<
	server_test::roundtrip [list certificates [list [server_test::pair a]]] a.test
} -result [list ok "echo: hello\n"]
#>>>
test server-1.2 {A wildcard name in the certificate} -body { #<<<
	server_test::roundtrip [list certificates [list [server_test::pair a]]] www.a.test
} -result [list ok "echo: hello\n"]
#>>>
test server-1.4 {A client and a server with the default security policy negotiate TLS 1.3} -body { #<<<
	# Not without RSA-PSS from the libcrypto, which s2n-tls's build learns from its feature probes:
	# a build without them (as release tarballs were, trimmed) offered only TLS 1.2 as a client
	server_test::roundtrip [list certificates [list [server_test::pair a]]] a.test
	set server_test::protocol
} -result TLSv1.3
#>>>
test server-1.3 {A name the certificate doesn't cover fails the client's check} -body { #<<<
	lindex [server_test::roundtrip [list certificates [list [server_test::pair a]]] b.test] 0
} -result error
#>>>
test server-2.1 {Two certificates: SNI picks the second} -body { #<<<
	server_test::roundtrip [list certificates [list [server_test::pair a] [server_test::pair b]]] www.b.test
} -result [list ok "echo: hello\n"]
#>>>
test server-2.2 {Two certificates: SNI picks the first} -body { #<<<
	server_test::roundtrip [list certificates [list [server_test::pair a] [server_test::pair b]]] a.test
} -result [list ok "echo: hello\n"]
#>>>
test server-2.3 {Two certificates, a name neither covers: no handshake} -body { #<<<
	lindex [server_test::roundtrip [list certificates [list [server_test::pair a] [server_test::pair b]]] c.test] 0
} -result error
#>>>
test server-2.4 {The same config value serves many connections} -body { #<<<
	set config	[list certificates [list [server_test::pair a] [server_test::pair b]]]
	lmap name {a.test b.test x.a.test x.b.test} {lindex [server_test::roundtrip $config $name] 0}
} -cleanup {
	unset -nocomplain config
} -result {ok ok ok ok}
#>>>
test server-3.1 {A server without certificates can't handshake: both ends hear of it, and nothing sleeps} -body { #<<<
	set start	[clock milliseconds]
	list [lindex [server_test::roundtrip "" a.test] 0] [info exists server_test::server_err] [expr {[clock milliseconds] - $start < 2000}]
} -cleanup {
	unset -nocomplain start
} -result {error 1 1}
#>>>
test server-3.2 {-blinding self: the channel says how long s2n wants us to wait before closing} -body { #<<<
	server_test::roundtrip "" a.test
	expr {$server_test::server_delay >= 10000 && $server_test::server_delay <= 30000}
} -result 1
#>>>
test server-3.3 {-blinding: a bad value} -body { #<<<
	set listen	[socket -server {apply {{sock args} {close $sock}}} -myaddr 127.0.0.1 0]
	set sock	[socket 127.0.0.1 [lindex [chan configure $listen -sockname] 2]]
	s2n::push $sock -role server -blinding none
} -cleanup {
	catch {close $sock}
	close $listen
	unset -nocomplain sock listen
} -returnCodes error -result {bad blinding "none": must be builtin or self}
#>>>
test server-3.4 {-blinding_delay is 0 on a healthy connection} -body { #<<<
	set listen	[socket -server {apply {{sock args} {close $sock}}} -myaddr 127.0.0.1 0]
	set sock	[socket 127.0.0.1 [lindex [chan configure $listen -sockname] 2]]
	chan configure $sock -blocking 0
	s2n::push $sock -role server -blinding self -config [list certificates [list [server_test::pair a]]]
	chan configure $sock -blinding_delay
} -cleanup {
	catch {close $sock}
	close $listen
	unset -nocomplain sock listen
} -result 0
#>>>
test server-4.1 {certificates: an entry that isn't a pair} -body { #<<<
	server_test::push_server [list certificates [list [list [server_test::pem a.pem]]]]
} -returnCodes error -result {each certificates entry must be a list of two PEM strings, the chain and its key}
#>>>
test server-4.1.1 {certificates: a malformed entry isn't echoed in the error (it may hold the key)} -body { #<<<
	list [catch {server_test::push_server [list certificates [list [list [server_test::pem a.key]]]]} r o] [string match *PRIVATE* $r] [string match *PRIVATE* [dict get $o -errorinfo]]
} -cleanup {
	unset -nocomplain r o
} -result {1 0 0}
#>>>
test server-4.2 {certificates: an empty list} -body { #<<<
	server_test::push_server {certificates {}}
} -returnCodes error -result {certificates must name at least one {chain key} pair}
#>>>
test server-4.3 {certificates: a key that isn't the chain's} -body { #<<<
	server_test::push_server [list certificates [list [list [server_test::pem a.pem] [server_test::pem b.key]]]]
} -returnCodes error -match glob -errorCode {S2N *} -result *
#>>>
test server-4.4 {certificates: not PEM} -body { #<<<
	server_test::push_server {certificates {{notpem notpem}}}
} -returnCodes error -match glob -errorCode {S2N *} -result *
#>>>

# Handshakes that fail, as a server facing a peer that doesn't speak TLS: a handshake record
# holding nonsense, which s2n rejects (and blinds) as soon as it reads it
namespace eval server_test {
	variable bad	[binary decode hex 16030100050100000100]

	proc badpeer {when {blocking 0}} { # What the server's script sees: {push's outcome, the read's errorcode, -blinding_delay in range, has -handshake_error, close's outcome} <<<
		variable bad
		variable seen
		unset -nocomplain seen

		set listen	[socket -server [list apply {{when blocking ns sock args} {
			# Give the peer's bytes time to arrive before the push (early), or push before they're sent
			after [expr {$when eq "early" ? 100 : 0}] [list apply {{blocking ns sock} {
				chan configure $sock -blocking $blocking -buffering none -translation binary
				if {[catch {s2n::push $sock -role server -blinding self -config [list certificates [list [server_test::pair a]]]} r]} {
					close $sock
					set ${ns}::seen [list [list threw $r]]
					return
				}
				chan event $sock readable [list apply {{ns sock} {
					set code	[catch {read $sock} r o]
					chan event $sock readable {}
					set delay	[chan configure $sock -blinding_delay]
					set ${ns}::seen [list \
						pushed \
						[if {$code} {lindex [dict get $o -errorcode] 1} else {list read ok}] \
						[expr {$delay >= 10000 && $delay <= 30000}] \
						[expr {[chan configure $sock -handshake_error] ne ""}] \
						[list [catch {close $sock} r] $r] \
					]
				}} $ns $sock]
			}} $blocking $ns $sock]
		}} $when $blocking [namespace current]] -myaddr 127.0.0.1 0]
		try {
			set peer	[socket 127.0.0.1 [lindex [chan configure $listen -sockname] 2]]
			chan configure $peer -buffering none -translation binary
			after [expr {$when eq "early" ? 0 : 100}] [list puts -nonewline $peer $bad]
			set timeout	[after 5000 [list set [namespace current]::seen timeout]]
			vwait [namespace current]::seen
			after cancel $timeout
			set seen
		} finally {
			catch {close $peer}
			close $listen
		}
	}

	#>>>
}

test server-5.1 {A handshake that fails within s2n::push (non-blocking): reported by the channel, with its blinding delay, and closing early is fine} -body { #<<<
	server_test::badpeer early
} -result {pushed EPROTO 1 1 {0 {}}}
#>>>
test server-5.2 {A handshake that fails later: the same} -body { #<<<
	server_test::badpeer late
} -result {pushed EPROTO 1 1 {0 {}}}
#>>>
test server-5.3 {A handshake that fails on a blocking channel: an error from s2n::push} -body { #<<<
	server_test::badpeer early 1
} -match glob -result {{threw {s2n_negotiate failed: *}}}
#>>>
test server-5.4 {A peer that disconnects mid-handshake: connection reset, nothing to blind} -body { #<<<
	set listen	[socket -server {apply {{sock args} {
		chan configure $sock -blocking 0 -buffering none -translation binary
		s2n::push $sock -role server -blinding self -config [list certificates [list [server_test::pair a]]]
		chan event $sock readable [list apply {sock {
			set code	[catch {read $sock} r o]
			set ::server_test::seen [list [lindex [dict get $o -errorcode] 1] [chan configure $sock -blinding_delay] [catch {close $sock}]]
		}} $sock]
	}}} -myaddr 127.0.0.1 0]
	set peer	[socket 127.0.0.1 [lindex [chan configure $listen -sockname] 2]]
	chan configure $peer -buffering none -translation binary
	puts -nonewline $peer [binary decode hex 160301]
	close $peer
	set timeout	[after 5000 {set ::server_test::seen timeout}]
	vwait ::server_test::seen
	after cancel $timeout
	set ::server_test::seen
} -cleanup {
	close $listen
	unset -nocomplain listen peer timeout
} -result {ECONNRESET 0 0}
#>>>
test server-5.5 {A client (s2n::socket -async) refusing the server's certificate: EPROTO, the reason, its own delay, and an early close} -body { #<<<
	set listen	[socket -server [list server_test::accept [list certificates [list [server_test::pair a]]]] -myaddr 127.0.0.1 0]
	set sock	[s2n::socket -async -blinding self -servername b.test -config [list ca_file [file join $server_test::certs ca.pem]] 127.0.0.1 [lindex [chan configure $listen -sockname] 2]]
	chan configure $sock -blocking 0
	chan event $sock readable [list apply {sock {
		set code	[catch {read $sock} r o]
		chan event $sock readable {}
		set delay	[chan configure $sock -blinding_delay]
		set ::server_test::seen [list \
			[lindex [dict get $o -errorcode] 1] \
			[expr {$delay >= 10000 && $delay <= 30000}] \
			[expr {[chan configure $sock -handshake_error] ne ""}] \
			[list [catch {close $sock} r] $r] \
		]
	}} $sock]
	set timeout	[after 5000 {set ::server_test::seen timeout}]
	vwait ::server_test::seen
	after cancel $timeout
	set ::server_test::seen
} -cleanup {
	close $listen
	unset -nocomplain listen sock timeout
} -result {EPROTO 1 1 {0 {}}}
#>>>
test server-5.6 {A failed handshake nobody is watching doesn't spin, and a write hears of it too} -body { #<<<
	set listen	[socket -server {apply {{sock args} {
		chan configure $sock -blocking 0 -buffering none -translation binary
		s2n::push $sock -role server -blinding self -config [list certificates [list [server_test::pair a]]]
		set ::server_test::ssock $sock
	}}} -myaddr 127.0.0.1 0]
	set peer	[socket 127.0.0.1 [lindex [chan configure $listen -sockname] 2]]
	chan configure $peer -buffering none -translation binary
	after 50 [list puts -nonewline $peer $server_test::bad]
	set cpu	{apply {{} {set h [open /proc/self/stat]; try {set s [read $h]} finally {close $h}; expr {[lindex $s 13]+[lindex $s 14]}}}}
	# Let the handshake fail, then see that waiting costs (next to) no CPU time
	after 300 {set ::server_test::seen 1}
	vwait ::server_test::seen
	set before	[{*}$cpu]
	after 300 {set ::server_test::seen 2}
	vwait ::server_test::seen
	list [expr {[{*}$cpu] - $before < 10}] [catch {puts -nonewline $server_test::ssock x} r o] [lindex [dict get $o -errorcode] 1] [catch {close $server_test::ssock}]
} -cleanup {
	catch {close $peer}
	close $listen
	unset -nocomplain listen peer cpu before r o
} -result {1 1 EPROTO 0}
#>>>

test server-6.1 {Closing after the peer closed first isn't an error, for either kind of channel} -body { #<<<
	lmap first {server client} {
		unset -nocomplain ::server_test::ssock ::server_test::seen
		set listen	[socket -server {apply {{sock args} {
			chan configure $sock -blocking 0 -buffering none -translation binary
			s2n::push $sock -role server -config [list certificates [list [server_test::pair a]]]
			set ::server_test::ssock $sock
		}}} -myaddr 127.0.0.1 0]
		set sock	[s2n::socket -async -servername a.test -config [list ca_file [file join $server_test::certs ca.pem]] 127.0.0.1 [lindex [chan configure $listen -sockname] 2]]
		chan configure $sock -blocking 0
		chan event $sock writable {set ::server_test::seen 1}	;# The handshake is done
		set timeout	[after 5000 {set ::server_test::seen timeout}]
		vwait ::server_test::seen
		after cancel $timeout
		chan event $sock writable {}
		set order	[if {$first eq "server"} {list $::server_test::ssock $sock} else {list $sock $::server_test::ssock}]
		set res		[lmap chan $order {list [catch {close $chan} r] $r}]
		close $listen
		set res
	}
} -cleanup {
	unset -nocomplain listen sock timeout order res first chan r
} -result {{{0 {}} {0 {}}} {{0 {}} {0 {}}}}
#>>>

::tcltest::cleanupTests
return

# vim: ft=tcl foldmethod=marker foldmarker=<<<,>>> ts=4 shiftwidth=4
